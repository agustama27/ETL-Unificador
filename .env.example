# Plantilla del .env del stack. SOLO NOMBRES, nunca valores reales.
#
# El .env real se crea en la VM, con chmod 600, y NO se versiona: esta en .gitignore.
# Copiar con `cp .env.example .env` y completar.

# Puerto del host que publica el frontend. Se elige DESPUES de inspeccionar la VM
# con `ss -lnt` y `docker ps`: es compartida y tomar un puerto ocupado rompe otro
# stack. Rango sugerido por la guia: 8081-8099.
ETL_HOST_PORT=

# Token de la consola. La API es fail-closed: sin este valor responde 503 a todo
# /api. Generar con `openssl rand -hex 32`.
# En el navegador se carga en localStorage con la clave `etl_token`.
ETL_CONSOLE_TOKEN=

# Corridas simultaneas. Cada una lanza un subproceso que carga la base en memoria
# con pandas; subirlo sin mirar la RAM de la VM compartida es como se la llena.
ETL_MAX_CONCURRENT_RUNS=2

# Dias que se conservan la evidencia de corridas y los uploads antes de purgarse.
ETL_RETENTION_DAYS=30

# Zona horaria. NO es cosmetica: define el nombre de los archivos de salida.
TZ=America/Argentina/Buenos_Aires

# Webhook opcional de notificacion post-corrida. Vacio = desactivado.
ETL_NOTIFY_WEBHOOK=
